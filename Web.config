<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config for the GLPI-Demo static prototype (IIS / IIS Express).
  Adapted from the Dashboard's Web.config.ejemplo: only the static-site parts
  (security headers, default document, cache policy, request filtering).
  No connection strings, no secrets, no ASP.NET code: safe to commit.
-->
<configuration>
  <system.webServer>
    <!-- Security headers (same as Dashboard). SAMEORIGIN: no third-party
         iframing; nosniff: browser does not guess file types. -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- "Cache-Control: no-cache": browser revalidates every file, so an
         edited demo is never shown stale (unchanged files come back as 304). -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- Only the site itself is served: repo metadata, docs and launch
         scripts are not reachable over HTTP. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <!-- .config is already denied by IIS defaults; adding it again is a
               duplicate-entry error (HTTP 500.19). -->
        </fileExtensions>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".gitignore" />
          <add segment=".gitattributes" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
